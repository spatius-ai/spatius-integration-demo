# Copy the DIRECT_MODE_URL line into local.properties (which is git-ignored and also
# holds your sdk.dir). It is the only setting this app has: everything else — the App
# ID, the API key, the avatar, the language — lives in the server's .env, and the app
# reads what it needs from GET /api/config at launch.

# Where the Direct Mode server is reachable from the device.
#
#   http://10.0.2.2:8090      the emulator's route to the host machine (the default)
#   http://192.168.1.10:8090  a physical device on the same LAN — use the address the
#                             server prints at startup; a phone cannot reach localhost
DIRECT_MODE_URL=http://10.0.2.2:8090
