# Copy to .env and fill in your own credentials.
#
# RTC Mode: the avatar joins the call itself. Audio travels on an RTC track and the
# motion rides along encoded in the video stream, so nothing streams through this
# server — it only issues credentials and gets the agent into the room.


# --------------------------------------------------------------- Transport
# Which RTC path the avatar comes in on. The demo behaves identically either way;
# the credentials differ:
#
#   livekit  The conversation runs on this machine. This server starts the agent
#            worker for you, and models go through LiveKit Inference — so you do
#            not need an account with each provider.
#   agora    Agora's Conversational AI Engine hosts ASR/LLM/TTS and the avatar.
#            Models and voice are configured in its console instead of here.
#
# The web clients speak both and the config page can switch between them. The
# mobile clients ship the Agora SDK alone and always ask for `agora`, whatever
# this is set to.
TRANSPORT=livekit


# ---------------------------------------------------------------- Spatius
# https://app.spatius.ai/apps
SPATIUS_APP_ID=your_spatius_app_id
SPATIUS_API_KEY=your_spatius_api_key

# Which avatar joins. Leave blank for a public sample any account can load.
# https://app.spatius.ai/avatars/library
SPATIUS_AVATAR_ID=


# ---------------------------------------------------------------- LiveKit
# Needed when TRANSPORT=livekit.
# https://cloud.livekit.io — the API secret is shown only once, at creation.
#
# The conversation runs through a LiveKit agent and its models are routed by LiveKit
# Inference, so you do not need an OpenAI, Deepgram or Cartesia account of your own.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# ------------------------------------------------------------------ Agora
# Needed when TRANSPORT=agora. https://console.shengwang.cn (or console.agora.io)
#
# App ID and certificate come from the project's own page; enable the App
# Certificate there, since tokens cannot be signed without it.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Which published agent to run. Create one under Conversational AI → Agents, set
# its prompt, ASR, LLM and TTS there, publish it, and copy the id here. That is
# where models and voice are configured on this path — none of them are sent from
# this server.
#
# ⚠️ The ASR credential ids in agora.py belong to the console this demo was built
# against. Running it against your own agent means replacing them — a mismatch is
# silent, and shows up as speech that transcribes to nothing.
AGORA_PIPELINE_ID=

# The avatar's audio sample rate, which must equal the TTS output rate configured
# in the console. Motion Server accepts 8000/16000/22050/24000/32000/44100/48000
# and does not resample — a mismatch is silent, with the avatar joining and never
# making a sound. Leave blank for 24000, which is what most TTS actually emits.
AGORA_AVATAR_SAMPLE_RATE=


# ------------------------------------------------------------------ Models
# TRANSPORT=livekit only — on the Agora path these live in its console.
# For the accepted values see STTModels / LLMModels / TTSModels in
# livekit.agents.inference.
STT_MODEL=deepgram/nova-3
LLM_MODEL=openai/gpt-4.1-mini
TTS_MODEL=cartesia/sonic-2

# Recognition and synthesis follow the language picked in the client, so there is no
# language setting here.
# TTS voice — leave blank for the model's default. Note the accent comes from the
# voice rather than the language: some default voices read Chinese with an accent.
TTS_VOICE=

# How long to wait before deciding the user has finished talking. The default
# ceiling is 2.5s, which is the largest single part of the delay before a reply.
ENDPOINTING_MAX_DELAY=0.5


# ------------------------------------------------------------------ Server
# RTC_SERVER_PORT rather than SERVER_PORT: Backend Mode reads that name as well,
# and one exported in the shell would move both servers onto the same port.
RTC_SERVER_PORT=8790
