# Copy to .env and fill in your own credentials.
#
# LiveKit demo: the avatar joins the call itself. Audio travels on an RTC track and
# the motion rides along encoded in the video stream, so nothing streams through this
# server — it only issues credentials and gets the agent into the room.
#
# The conversation runs on this machine: this server starts the agent worker for you,
# and models go through LiveKit Inference — so you do not need an account with each
# provider.


# ---------------------------------------------------------------- Spatius
# https://app.spatius.ai/apps
SPATIUS_APP_ID=your_spatius_app_id
SPATIUS_API_KEY=your_spatius_api_key

# Which avatar joins. Leave blank for a public sample any account can load.
# https://app.spatius.ai/avatars/library
SPATIUS_AVATAR_ID=


# ---------------------------------------------------------------- LiveKit
# https://cloud.livekit.io — the API secret is shown only once, at creation.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# ------------------------------------------------------------------ Models
# Routed by LiveKit Inference. For the accepted values see STTModels / LLMModels /
# TTSModels in livekit.agents.inference.
STT_MODEL=deepgram/nova-3
LLM_MODEL=openai/gpt-4.1-mini
TTS_MODEL=cartesia/sonic-2

# Recognition and synthesis follow the language picked in the client, so there is no
# language setting here.
# TTS voice — leave blank for the model's default. Note the accent comes from the
# voice rather than the language: some default voices read Chinese with an accent.
TTS_VOICE=

# How long to wait before deciding the user has finished talking. The default
# ceiling is 2.5s, which is the largest single part of the delay before a reply.
ENDPOINTING_MAX_DELAY=0.5


# ------------------------------------------------------------------ Server
# RTC_SERVER_PORT rather than SERVER_PORT: Backend Mode reads that name as well,
# and one exported in the shell would move both servers onto the same port.
# The Agora demo's server uses the same port, so run one of the two at a time.
RTC_SERVER_PORT=8790
