# Copy to .env and fill in your own credentials.
#
# Blank entries are yours to fill in. Anything that already has a value has a working
# default and can be left alone.
#
# The clients hold none of this. Direct Mode keeps the API Key on the server and hands
# the browser a short-lived Session Token instead, so there is no client-side .env to
# keep in sync — the App ID and avatar reach the client from GET /api/config.


# ---------------------------------------------------------------- Spatius
# Needed by both scenes. https://app.spatius.ai/apps
SPATIUS_API_KEY=your_spatius_api_key
SPATIUS_APP_ID=your_spatius_app_id

# Which avatar to render. Leave blank for a public sample avatar any account can load.
# For your own see https://app.spatius.ai/avatars/library
SPATIUS_AVATAR_ID=

# Region. Leave as-is unless you need to pin a different one.
# https://docs.spatius.ai/api-reference/regions
SPATIUS_REGION=us-west

# Advanced override — only for proxying or a staging endpoint. Composed from the
# region when blank.
# SPATIUS_CONSOLE_ENDPOINT=https://console.us-west.spatius.ai/v1/console


# ---------------------------------------------------------------- LiveKit
# Needed by the realtime scene only; the sample-audio scene runs without it.
# https://cloud.livekit.io — the API secret is shown only once, at creation.
#
# Models are routed by LiveKit Inference, so you do not need an OpenAI, Deepgram or
# Cartesia account of your own.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# ------------------------------------------------------------------ Models
# For the accepted values see STTModels / LLMModels / TTSModels in
# livekit.agents.inference.
STT_MODEL=deepgram/nova-3
LLM_MODEL=openai/gpt-4.1-mini
TTS_MODEL=cartesia/sonic-2

# Recognition and synthesis follow the language picked on the config page, so there
# is no language setting here.
# TTS voice — leave blank for the model's default; see each provider's voice library.
# Note the accent comes from the voice rather than from the language: some default
# voices read Chinese with an accent, and only a few give you Mandarin.
TTS_VOICE=

# The agent's persona. Spoken style — every character is read aloud.
LLM_SYSTEM_PROMPT=You are a friendly avatar assistant in a demo. Reply in spoken language, at most 50 words each time. Do not use Markdown or any symbol formatting.


# ------------------------------------------------------------------ Server
TOKEN_SERVER_PORT=8090
REALTIME_WS_PORT=8091
SESSION_TOKEN_TTL_MINUTES=55

# The clip the sample-audio scene plays. Defaults to assets/sample_voice.pcm.
# SAMPLE_AUDIO_FILE=
