# Copy the lines you need into local.properties (which is not committed).
#
# sdk.dir is written by Android Studio on first open; add it by hand for a
# command-line build.
sdk.dir=/Users/you/Library/Android/sdk

# Where the demo server is, baked in as BuildConfig.RTC_MODE_URL at build time.
# This is the only thing this app is configured with — the Spatius and Agora
# credentials, the conversation language and the voice all live in the server's
# servers/python/.env and never reach the device.
#
# Use 10.0.2.2 on the emulator (that is the host machine's loopback as seen from
# inside it) and the LAN address the server prints on startup on a real device.
# Defaults to http://10.0.2.2:8790 when this line is absent.
RTC_MODE_URL=http://10.0.2.2:8790
