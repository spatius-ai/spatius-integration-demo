# Copy to .env and fill in your own credentials.
#
# Agora demo: the avatar joins the call itself. Audio travels on an RTC track and the
# motion rides along encoded in the video stream, so nothing streams through this
# server — it only signs credentials and asks Agora to start the agent.
#
# The conversation is hosted by Agora's Conversational AI Engine: ASR/LLM/TTS and the
# voice are configured on a published agent in its console, not here.


# ---------------------------------------------------------------- Spatius
# https://app.spatius.ai/apps
SPATIUS_APP_ID=your_spatius_app_id
SPATIUS_API_KEY=your_spatius_api_key

# Which avatar joins. Leave blank for a public sample any account can load.
# https://app.spatius.ai/avatars/library
SPATIUS_AVATAR_ID=

# Which Spatius region the avatar is served from. Leave blank for cn-beijing; set
# us-west for accounts on the US endpoint (https://docs.spatius.ai/api-reference/regions).
SPATIUS_REGION=


# ------------------------------------------------------------------ Agora
# https://console.shengwang.cn (or console.agora.io)
#
# App ID and certificate come from the project's own page; enable the App
# Certificate there, since tokens cannot be signed without it. They are two
# different values — the certificate field is masked in the console, so check that
# what you copied is not the App ID again.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Which published agent to run. Create one under Conversational AI → Agents, set
# its prompt, LLM and TTS there, publish it, and copy the id here. That is where
# models and voice are configured — none of them are sent from this server.
#
# Leave the agent's ASR at the console defaults (Deepgram nova-3): this server sends
# that vendor and model with every session. Changing them in the console means
# changing ASR_VENDOR / ASR_MODEL in agora.py too — a mismatch is silent, and shows up
# as speech that transcribes to nothing.
AGORA_PIPELINE_ID=

# The avatar's audio sample rate, which must equal the TTS output rate configured
# in the console. Motion Server accepts 8000/16000/22050/24000/32000/44100/48000
# and does not resample — a mismatch is silent, with the avatar joining and never
# making a sound. Leave blank for 24000, which is what most TTS actually emits.
AGORA_AVATAR_SAMPLE_RATE=

# ConvoAI's REST endpoint. Leave blank for https://api.agora.io; projects created in
# the Shengwang (China) console use that console's endpoint instead.
AGORA_CONVOAI_BASE_URL=


# ------------------------------------------------------------------ Server
# RTC_SERVER_PORT rather than SERVER_PORT: Backend Mode reads that name as well,
# and one exported in the shell would move both servers onto the same port.
# The LiveKit demo's server uses the same port, so run one of the two at a time.
RTC_SERVER_PORT=8790
