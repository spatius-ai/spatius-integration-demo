# Copy to .env.local (or .env) if the demo server is not on this machine's port 8790.
#
# Left unset, the client uses the page's own host on port 8790 — which is right when
# both run on your machine. Set it when the server lives elsewhere, or when you open
# the page from a phone on the LAN.
#
# Everything else is the server's: credentials, the conversation language, the voice
# all live in servers/python/.env, and none of them are configured here.
VITE_DEMO_SERVER_URL=http://192.168.1.10:8790
