# Copy to .env and fill in your own credentials.
#
# Backend Mode: this server owns the Motion Server connection and drives the avatar.
# Clients are thin — they capture microphone audio and render what comes back, and
# hold no credentials at all.


# ── Server ────────────────────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8765
# Leave blank for the usual dev ports on localhost.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000


# ── Spatius ───────────────────────────────────────────────────────
# Needed by both scenes. https://app.spatius.ai/apps
SPATIUS_APP_ID=your_spatius_app_id
SPATIUS_API_KEY=your_spatius_api_key

# Which avatar to render. https://app.spatius.ai/avatars/library
SPATIUS_AVATAR_ID=aed008e4-8ddf-41aa-b5b2-5d7321dd4165

# Region. https://docs.spatius.ai/api-reference/regions
SPATIUS_REGION=us-west

# Advanced overrides — only for proxying or a staging endpoint. Composed from the
# region when blank.
# SPATIUS_CONSOLE_ENDPOINT=https://console.us-west.spatius.ai/v1/console
# SPATIUS_INGRESS_ENDPOINT=wss://api.us-west.spatius.ai/v2/driveningress

AVATAR_OUTPUT_SAMPLE_RATE=16000
USER_INPUT_SAMPLE_RATE=16000

# The clip the pre-recorded scene plays. Defaults to assets/sample_voice.pcm.
# SAMPLE_AUDIO_FILE=


# ── LiveKit ───────────────────────────────────────────────────────
# Needed by the realtime scene only; the pre-recorded scene runs without it.
# https://cloud.livekit.io — the API secret is shown only once, at creation.
#
# The conversation runs through a LiveKit agent and its models are routed by
# LiveKit Inference, so you do not need an OpenAI, Deepgram or Cartesia account of
# your own — these three replace all of them.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# ── Models ────────────────────────────────────────────────────────
# For the accepted values see STTModels / LLMModels / TTSModels in
# livekit.agents.inference.
STT_MODEL=deepgram/nova-3
LLM_MODEL=openai/gpt-4.1-mini
TTS_MODEL=cartesia/sonic-2

# Recognition and synthesis follow the language picked in the client, so there is no
# language setting here.
# TTS voice — leave blank for the model's default; see each provider's voice library.
# Note the accent comes from the voice rather than from the language: some default
# voices read Chinese with an accent, and only a few give you Mandarin.
TTS_VOICE=

# The agent's persona. Leave blank to use a built-in one that follows the language.
LLM_SYSTEM_PROMPT=
